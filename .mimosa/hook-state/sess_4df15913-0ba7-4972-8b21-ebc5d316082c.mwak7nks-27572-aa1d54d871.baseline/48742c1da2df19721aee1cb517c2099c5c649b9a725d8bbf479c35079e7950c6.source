import { getFunctions, httpsCallable } from 'firebase/functions'
import { app } from './firebase'
import { isRecord } from './errors'
import type {
  BlockPlayerResult,
  FollowPlayerResult,
  GetPlayerProfileResult,
  PublicPlayerProfile,
} from '../types/social'
import { PLAYER_XP_TRUST } from '../types/social'

const functions = getFunctions(app, 'asia-southeast1')
const UID_PATTERN = /^[^.#$[\]/]{1,128}$/
const PROFILE_FIELDS = [
  'uid',
  'nickname',
  'nicknameCanonical',
  'communityXp',
  'xpTrust',
  'followerCount',
  'followingCount',
  'publishedDeckCount',
] as const

function requireUid(value: unknown): string {
  if (typeof value !== 'string' || !UID_PATTERN.test(value)) {
    throw new TypeError('uid must be a valid Firebase key')
  }
  return value
}

function isCount(value: unknown): value is number {
  return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0
}

export function isPublicPlayerProfile(value: unknown): value is PublicPlayerProfile {
  if (!isRecord(value) || Object.keys(value).length !== PROFILE_FIELDS.length) return false
  if (!PROFILE_FIELDS.every((field) => Object.hasOwn(value, field))) return false
  return typeof value.uid === 'string' && UID_PATTERN.test(value.uid) &&
    typeof value.nickname === 'string' && /^[A-Za-z0-9_]{3,24}$/.test(value.nickname) &&
    value.nicknameCanonical === value.nickname.toLowerCase() &&
    isCount(value.communityXp) &&
    value.xpTrust === PLAYER_XP_TRUST &&
    isCount(value.followerCount) &&
    isCount(value.followingCount) &&
    isCount(value.publishedDeckCount)
}

function parseProfileResult(value: unknown): GetPlayerProfileResult {
  if (!isRecord(value) || !isPublicPlayerProfile(value.profile) || !isRecord(value.social)) {
    throw new Error('Player service returned an invalid response')
  }
  if (typeof value.social.following !== 'boolean' || typeof value.social.followedBy !== 'boolean') {
    throw new Error('Player service returned an invalid response')
  }
  return {
    profile: value.profile,
    social: {
      following: value.social.following,
      followedBy: value.social.followedBy,
    },
  }
}

function parseFollowResult(value: unknown, expectedUid: string, expectedFollowing: boolean): FollowPlayerResult {
  if (!isRecord(value) || value.targetUid !== expectedUid || value.following !== expectedFollowing) {
    throw new Error('Player service returned an invalid response')
  }
  return { targetUid: expectedUid, following: expectedFollowing }
}

function parseBlockResult(value: unknown, expectedUid: string, expectedBlocked: boolean): BlockPlayerResult {
  if (!isRecord(value) || value.targetUid !== expectedUid || value.blocked !== expectedBlocked) {
    throw new Error('Player service returned an invalid response')
  }
  return { targetUid: expectedUid, blocked: expectedBlocked }
}

const getPlayerProfileCallable = httpsCallable<{ uid: string }, unknown>(functions, 'getPlayerProfile')
const followPlayerCallable = httpsCallable<{ uid: string }, unknown>(functions, 'followPlayer')
const unfollowPlayerCallable = httpsCallable<{ uid: string }, unknown>(functions, 'unfollowPlayer')
const blockPlayerCallable = httpsCallable<{ uid: string }, unknown>(functions, 'blockPlayer')
const unblockPlayerCallable = httpsCallable<{ uid: string }, unknown>(functions, 'unblockPlayer')

/** Exact lookup only; this API never lists or searches player identities. */
export async function getPlayerProfile(uid: unknown): Promise<GetPlayerProfileResult> {
  const targetUid = requireUid(uid)
  return parseProfileResult((await getPlayerProfileCallable({ uid: targetUid })).data)
}

export async function followPlayer(uid: unknown): Promise<FollowPlayerResult> {
  const targetUid = requireUid(uid)
  return parseFollowResult((await followPlayerCallable({ uid: targetUid })).data, targetUid, true)
}

export async function unfollowPlayer(uid: unknown): Promise<FollowPlayerResult> {
  const targetUid = requireUid(uid)
  return parseFollowResult((await unfollowPlayerCallable({ uid: targetUid })).data, targetUid, false)
}

export async function blockPlayer(uid: unknown): Promise<BlockPlayerResult> {
  const targetUid = requireUid(uid)
  return parseBlockResult((await blockPlayerCallable({ uid: targetUid })).data, targetUid, true)
}

export async function unblockPlayer(uid: unknown): Promise<BlockPlayerResult> {
  const targetUid = requireUid(uid)
  return parseBlockResult((await unblockPlayerCallable({ uid: targetUid })).data, targetUid, false)
}
