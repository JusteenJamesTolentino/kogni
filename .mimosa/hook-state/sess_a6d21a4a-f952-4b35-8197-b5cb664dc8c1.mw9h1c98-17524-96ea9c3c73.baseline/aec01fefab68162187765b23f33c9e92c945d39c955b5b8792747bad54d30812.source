import { useEffect, useId, useMemo, useState } from 'react'
import confetti from 'canvas-confetti'
import { AnimatePresence, motion } from 'framer-motion'
import { ArrowLeft, Brain, Check, Eye, Sparkles, X } from 'lucide-react'
import { calculateSm2 } from '../lib/sm2'
import { updateCardProgress } from '../lib/db'
import { awardReviewXp } from '../lib/leaderboard'
import { useAuth } from '../context/AuthContext'

const ratings = [
  { quality: 0, label: 'Blank', hint: 'No recall', className: 'btn-error' },
  { quality: 1, label: 'Wrong', hint: 'Incorrect', className: 'btn-error' },
  { quality: 2, label: 'Hard', hint: 'Barely', className: 'btn-warning' },
  { quality: 3, label: 'Okay', hint: 'With effort', className: 'btn-warning' },
  { quality: 4, label: 'Good', hint: 'Correct', className: 'btn-success' },
  { quality: 5, label: 'Easy', hint: 'Instant', className: 'btn-success' }
]

const getQuestion = card => card.question || card.front || card.prompt || 'Untitled question'
const getAnswer = card => card.answer || card.back || card.response || 'No answer was provided.'

export default function StudySession({ cards, deck, onExit, onFinished }) {
  const { user } = useAuth()
  const [index, setIndex] = useState(0)
  const [revealed, setRevealed] = useState(false)
  const [selectedChoice, setSelectedChoice] = useState(null)
  const [saving, setSaving] = useState(false)
  const [error, setError] = useState('')
  const [complete, setComplete] = useState(false)
  const [sessionXp, setSessionXp] = useState(0)
  const sessionId = useId()
  const card = cards[index]
  const choices = useMemo(() => {
    if (!card || !Array.isArray(card.distractors) || card.distractors.length === 0) return []
    const answer = getAnswer(card)
    const seed = Array.from(String(card.id || index)).reduce(
      (total, character) => total + character.charCodeAt(0),
      0,
    )
    const options = [answer, ...card.distractors]
    const offset = seed % options.length
    return [...options.slice(offset), ...options.slice(0, offset)]
  }, [card, index])
  const progress = cards.length ? ((index + (revealed ? 0.5 : 0)) / cards.length) * 100 : 0

  const handleRate = async quality => {
    if (!card || saving) return
    setSaving(true)
    setError('')

    try {
      const progressUpdate = calculateSm2(card, quality)
      await updateCardProgress({ ...card, ...progressUpdate })
      const eventId = `${sessionId}-${card.id || card.cardId || index}`

      try {
        const award = await awardReviewXp(user, eventId, quality)
        const earnedXp = award?.awarded ? Number(award.xpAwarded || 0) : 0
        if (earnedXp > 0) {
          setSessionXp(previous => previous + earnedXp)
          localStorage.setItem(
            `kognit_xp_${user.uid}`,
            String(Number(localStorage.getItem(`kognit_xp_${user.uid}`) || 0) + earnedXp),
          )
        }
      } catch {
        // Saving study progress is more important than optional leaderboard XP
      }

      if (index >= cards.length - 1) {
        setComplete(true)
        confetti({ particleCount: 120, spread: 80, origin: { y: 0.7 }, colors: ['#7c3aed', '#22c55e', '#f59e0b'] })
      } else {
        setIndex(previous => previous + 1)
        setRevealed(false)
        setSelectedChoice(null)
      }
    } catch (reviewError) {
      setError(reviewError?.message || 'Your rating could not be saved. Please try again.')
    } finally {
      setSaving(false)
    }
  }

  useEffect(() => {
    const handleKeyDown = event => {
      if (event.key === ' ' && card && !revealed && !choices.length) {
        event.preventDefault()
        setRevealed(true)
      }
      if (revealed && /^[0-5]$/.test(event.key)) handleRate(Number(event.key))
      if (event.key === 'Escape') onExit()
    }

    window.addEventListener('keydown', handleKeyDown)
    return () => window.removeEventListener('keydown', handleKeyDown)
  })

  const revealChoice = choice => {
    if (revealed) return
    setSelectedChoice(choice)
    setRevealed(true)
  }

  if (!cards.length) {
    return (
      <main className="grid min-h-[70vh] place-items-center px-4">
        <div className="max-w-md text-center">
          <Brain size={42} className="mx-auto text-base-content/30" aria-hidden="true" />
          <h1 className="mt-4 text-2xl font-bold">Nothing to review yet</h1>
          <p className="mt-2 text-base-content/60">This deck has no cards, or all reviews are complete for today.</p>
          <button type="button" onClick={onExit} className="btn btn-primary mt-5">Back to dashboard</button>
        </div>
      </main>
    )
  }

  if (complete) {
    return (
      <main className="grid min-h-[75vh] place-items-center px-4 py-12">
        <motion.section initial={{ opacity: 0, scale: 0.94 }} animate={{ opacity: 1, scale: 1 }} className="card w-full max-w-lg border border-base-300 bg-base-100 text-center shadow-2xl">
          <div className="card-body items-center p-8 sm:p-12">
            <div className="grid h-20 w-20 place-items-center rounded-full bg-success/15 text-success"><Check size={40} strokeWidth={3} aria-hidden="true" /></div>
            <div className="badge badge-success badge-outline mt-2 gap-1"><Sparkles size={13} aria-hidden="true" /> Session complete</div>
            <h1 className="mt-1 text-3xl font-black">Excellent work</h1>
            <p className="text-base-content/60">You reviewed all {cards.length} cards and earned {sessionXp} XP. Come back when the next cards are due.</p>
            <div className="card-actions mt-4 w-full">
              <button type="button" onClick={onFinished} className="btn btn-primary w-full">Return to dashboard</button>
            </div>
          </div>
        </motion.section>
      </main>
    )
  }

  const correctAnswer = card.correctAnswer || card.correct || getAnswer(card)
  const choiceCorrect = selectedChoice !== null && String(selectedChoice) === String(correctAnswer)

  return (
    <main className="mx-auto w-full max-w-4xl px-4 py-5 sm:px-6 sm:py-8 lg:px-8">
      <header className="mb-5 flex items-center gap-3">
        <button type="button" onClick={onExit} className="btn btn-ghost btn-circle btn-sm" aria-label="Exit study session"><ArrowLeft size={19} aria-hidden="true" /></button>
        <div className="min-w-0 flex-1">
          <div className="flex items-center justify-between text-xs font-semibold text-base-content/55">
            <span className="truncate">{deck?.title || deck?.name || 'Due cards'}</span>
            <span>{index + 1} / {cards.length}</span>
          </div>
          <progress className="progress progress-primary mt-2 h-2 w-full" value={progress} max="100" aria-label={`${Math.round(progress)} percent complete`} />
        </div>
        <button type="button" onClick={onExit} className="btn btn-ghost btn-circle btn-sm" aria-label="Close study session"><X size={19} aria-hidden="true" /></button>
      </header>

      <section aria-live="polite">
        <AnimatePresence mode="wait">
          <motion.div key={card.id || card.cardId || index} initial={{ opacity: 0, x: 24 }} animate={{ opacity: 1, x: 0 }} exit={{ opacity: 0, x: -24 }}>
            <div className="card min-h-[22rem] overflow-hidden border border-base-300 bg-base-100 shadow-xl sm:min-h-[25rem]">
              <motion.div className="card-body justify-center p-6 text-center sm:p-10" animate={{ rotateY: revealed ? 180 : 0 }} transition={{ duration: 0.45 }} style={{ transformStyle: 'preserve-3d' }}>
                <div style={{ transform: revealed ? 'rotateY(180deg)' : 'none' }}>
                  <div className={`badge mb-5 ${revealed ? 'badge-secondary badge-outline' : 'badge-primary badge-outline'}`}>{revealed ? 'Answer' : 'Question'}</div>
                  {!revealed ? (
                    <>
                      <h1 className="mx-auto max-w-2xl text-2xl font-bold leading-snug sm:text-3xl">{getQuestion(card)}</h1>
                      {choices.length > 0 ? (
                        <div className="mx-auto mt-8 grid w-full max-w-xl gap-3 sm:grid-cols-2">
                          {choices.map((choice, choiceIndex) => <button key={`${choice}-${choiceIndex}`} type="button" onClick={() => revealChoice(choice)} className="btn h-auto min-h-12 justify-start whitespace-normal border-base-300 bg-base-200/50 px-4 py-3 text-left hover:btn-primary"><span className="badge badge-ghost badge-sm mr-1">{String.fromCharCode(65 + choiceIndex)}</span>{choice}</button>)}
                        </div>
                      ) : (
                        <button type="button" onClick={() => setRevealed(true)} className="btn btn-primary mt-9 gap-2"><Eye size={18} aria-hidden="true" /> Reveal answer</button>
                      )}
                    </>
                  ) : (
                    <>
                      {selectedChoice !== null && <div className={`badge mb-4 gap-1 ${choiceCorrect ? 'badge-success' : 'badge-error'}`}>{choiceCorrect ? <Check size={13} aria-hidden="true" /> : <X size={13} aria-hidden="true" />}{choiceCorrect ? 'Correct choice' : 'Not quite'}</div>}
                      <p className="mx-auto max-w-2xl text-2xl font-bold leading-relaxed sm:text-3xl">{getAnswer(card)}</p>
                      {card.explanation && <p className="mx-auto mt-5 max-w-2xl border-t border-base-300 pt-5 text-sm text-base-content/60">{card.explanation}</p>}
                    </>
                  )}
                </div>
              </motion.div>
            </div>

            {error && <div role="alert" className="alert alert-error mt-4"><span>{error}</span></div>}

            <AnimatePresence>
              {revealed && (
                <motion.div initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} className="mt-5 rounded-2xl border border-base-300 bg-base-100 p-4 sm:p-5">
                  <p className="mb-3 text-center text-sm font-semibold">How well did you know it?</p>
                  <div className="grid grid-cols-3 gap-2 sm:grid-cols-6">
                    {ratings.map(rating => (
                      <button key={rating.quality} type="button" onClick={() => handleRate(rating.quality)} disabled={saving} className={`btn h-auto min-h-14 flex-col gap-0 px-1 py-2 ${rating.className} btn-outline`} aria-label={`Rate ${rating.quality}: ${rating.label}, ${rating.hint}`}>
                        <span className="text-sm font-bold">{rating.label}</span><span className="text-[0.6rem] font-normal opacity-70">{rating.quality} · {rating.hint}</span>
                      </button>
                    ))}
                  </div>
                  {saving && <div className="mt-3 flex items-center justify-center gap-2 text-xs text-base-content/55"><span className="loading loading-spinner loading-xs" /> Saving progress…</div>}
                </motion.div>
              )}
            </AnimatePresence>
          </motion.div>
        </AnimatePresence>
      </section>

      <div className="mt-4 hidden justify-center gap-4 text-xs text-base-content/40 sm:flex">
        {!revealed ? <span>Press <kbd className="kbd kbd-xs">space</kbd> to reveal</span> : <span>Press <kbd className="kbd kbd-xs">0</kbd>–<kbd className="kbd kbd-xs">5</kbd> to rate</span>}
        <span><kbd className="kbd kbd-xs">esc</kbd> to exit</span>
      </div>
    </main>
  )
}
