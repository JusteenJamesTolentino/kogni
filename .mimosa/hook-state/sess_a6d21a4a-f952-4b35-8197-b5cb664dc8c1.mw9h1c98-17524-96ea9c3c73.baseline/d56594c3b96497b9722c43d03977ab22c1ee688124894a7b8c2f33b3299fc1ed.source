import { motion } from 'framer-motion'
import { BookOpen, ChevronRight, Clock3, Layers3, Play, Plus } from 'lucide-react'

const getDeckCount = deck => deck.cardCount ?? deck.cards?.length ?? deck.totalCards ?? 0

const getDeckDue = deck => deck.dueCount ?? deck.dueCards ?? 0

export default function DeckList({ decks, dueCards, loading, onStudy, onImport }) {
  if (loading) {
    return (
      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label="Loading decks">
        {[0, 1, 2].map(item => <div key={item} className="skeleton h-48 rounded-2xl" />)}
      </div>
    )
  }

  if (!decks.length) {
    return (
      <div className="hero min-h-72 rounded-3xl border border-dashed border-base-300 bg-base-200/45">
        <div className="hero-content text-center">
          <div className="max-w-md">
            <div className="mx-auto mb-4 grid h-14 w-14 place-items-center rounded-2xl bg-primary/10 text-primary">
              <Layers3 size={28} aria-hidden="true" />
            </div>
            <h3 className="text-xl font-bold">Your first deck is one import away</h3>
            <p className="mt-2 text-sm text-base-content/60">Upload notes, slides, or a PDF. Gemini will extract the key ideas and build recall-ready cards.</p>
            <button type="button" onClick={onImport} className="btn btn-primary mt-5 gap-2">
              <Plus size={18} aria-hidden="true" />
              Create a deck
            </button>
          </div>
        </div>
      </div>
    )
  }

  return (
    <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {decks.map((deck, index) => {
        const id = deck.id ?? deck.deckId ?? index
        const count = getDeckCount(deck)
        const directDue = getDeckDue(deck)
        const relatedDue = directDue || dueCards.filter(card => card.deckId === id).length

        return (
          <motion.article
            key={id}
            initial={{ opacity: 0, y: 12 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: Math.min(index * 0.04, 0.2) }}
            className="card group border border-base-300 bg-base-100 shadow-sm transition-all hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl"
          >
            <div className="card-body p-5">
              <div className="flex items-start justify-between gap-3">
                <div className="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-primary/10 text-primary transition-transform group-hover:scale-105">
                  <BookOpen size={22} aria-hidden="true" />
                </div>
                {relatedDue > 0 && <span className="badge badge-secondary badge-sm">{relatedDue} due</span>}
              </div>
              <div>
                <h3 className="mt-3 line-clamp-2 text-lg font-bold">{deck.title || deck.name || 'Untitled deck'}</h3>
                <p className="mt-1 line-clamp-2 min-h-10 text-sm text-base-content/55">{deck.description || deck.summary || 'A focused collection ready for review.'}</p>
              </div>
              <div className="mt-2 flex items-center gap-4 text-xs text-base-content/55">
                <span className="inline-flex items-center gap-1"><Layers3 size={14} aria-hidden="true" /> {count} cards</span>
                {deck.updatedAt && <span className="inline-flex items-center gap-1"><Clock3 size={14} aria-hidden="true" /> Updated</span>}
              </div>
              <div className="card-actions mt-2">
                <button type="button" onClick={() => onStudy(deck)} className="btn btn-primary btn-sm w-full gap-2" disabled={count === 0 && deck.cards?.length === 0}>
                  <Play size={15} fill="currentColor" aria-hidden="true" />
                  Study now
                  <ChevronRight size={15} className="ml-auto" aria-hidden="true" />
                </button>
              </div>
            </div>
          </motion.article>
        )
      })}
    </div>
  )
}
