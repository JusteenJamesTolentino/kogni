import { useRef, useState } from 'react'
import { FileText, KeyRound, Sparkles, UploadCloud, WandSparkles, X } from 'lucide-react'
import { generateDeckFromFile } from '../lib/gemini'
import { saveDeckWithCards } from '../lib/db'

const ACCEPTED_TYPES = '.pdf,image/*'
const MAX_FILE_SIZE = 15 * 1024 * 1024
const ALLOWED_MIME_TYPES = new Set([
  'application/pdf',
  'image/jpeg',
  'image/png',
  'image/webp',
  'image/gif',
])

export default function MagicImport({ apiKey, onOpenApiKey, onComplete }) {
  const inputRef = useRef(null)
  const [file, setFile] = useState(null)
  const [dragActive, setDragActive] = useState(false)
  const [status, setStatus] = useState('idle')
  const [error, setError] = useState('')

  const selectFile = selectedFile => {
    setError('')
    if (!selectedFile) return

    if (!ALLOWED_MIME_TYPES.has(selectedFile.type)) {
      setError('Choose a PDF or an image file (JPEG, PNG, WebP, or GIF).')
      return
    }

    if (selectedFile.size > MAX_FILE_SIZE) {
      setError('That file is larger than 15 MB. Choose a smaller file.')
      return
    }

    setFile(selectedFile)
  }

  const handleDrop = event => {
    event.preventDefault()
    setDragActive(false)
    selectFile(event.dataTransfer.files?.[0])
  }

  const handleGenerate = async () => {
    if (!apiKey) {
      onOpenApiKey()
      return
    }
    if (!file) return

    setStatus('generating')
    setError('')

    try {
      const generated = await generateDeckFromFile(file, apiKey)
      const cards = generated?.cards || generated?.deck?.cards || []
      const deck = generated?.deck
        ? { ...generated.deck, cards: undefined }
        : {
            title: generated?.title || file.name.replace(/\.[^.]+$/, ''),
            description: generated?.description || generated?.summary || `Generated from ${file.name}`,
            sourceName: file.name
          }

      if (!cards.length) throw new Error('Gemini did not find enough study material in this file.')

      await saveDeckWithCards(deck, cards)
      setStatus('success')
      window.setTimeout(() => onComplete?.({ ...deck, cards }), 700)
    } catch (generationError) {
      setStatus('error')
      setError(generationError?.message || 'We could not generate this deck. Check your key and try again.')
    }
  }

  return (
    <main className="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <section className="mx-auto max-w-3xl text-center">
        <div className="badge badge-primary badge-outline mb-3 gap-1.5"><WandSparkles size={14} aria-hidden="true" /> Magic import</div>
        <h1 className="text-3xl font-black tracking-tight sm:text-4xl">Turn a document into a study deck</h1>
        <p className="mx-auto mt-3 max-w-2xl text-base-content/60">Gemini identifies the essential concepts and transforms them into concise questions designed for active recall.</p>
      </section>

      <section className="mx-auto mt-8 max-w-3xl rounded-3xl border border-base-300 bg-base-100 p-4 shadow-xl sm:p-7" aria-labelledby="upload-title">
        {!apiKey && (
          <div role="alert" className="alert alert-warning mb-5">
            <KeyRound size={20} aria-hidden="true" />
            <div><h3 className="font-bold">Gemini key required</h3><p className="text-xs">Add a key before generating your deck.</p></div>
            <button type="button" onClick={onOpenApiKey} className="btn btn-sm">Add key</button>
          </div>
        )}

        <div
          className={`relative grid min-h-64 place-items-center rounded-2xl border-2 border-dashed p-6 text-center transition-colors ${dragActive ? 'border-primary bg-primary/10' : 'border-base-300 bg-base-200/40 hover:border-primary/50'}`}
          onDragEnter={event => { event.preventDefault(); setDragActive(true) }}
          onDragOver={event => event.preventDefault()}
          onDragLeave={() => setDragActive(false)}
          onDrop={handleDrop}
        >
          <input ref={inputRef} type="file" accept={ACCEPTED_TYPES} onChange={event => selectFile(event.target.files?.[0])} className="sr-only" aria-label="Choose a document to import" />

          {file ? (
            <div className="w-full max-w-md">
              <div className="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-success/10 text-success"><FileText size={28} aria-hidden="true" /></div>
              <h2 id="upload-title" className="mt-4 break-all text-lg font-bold">{file.name}</h2>
              <p className="mt-1 text-sm text-base-content/55">{(file.size / 1024 / 1024).toFixed(2)} MB · Ready to transform</p>
              <button type="button" onClick={() => setFile(null)} className="btn btn-ghost btn-sm mt-3 gap-1 text-error"><X size={15} aria-hidden="true" /> Remove</button>
            </div>
          ) : (
            <div>
              <div className="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-primary/10 text-primary"><UploadCloud size={28} aria-hidden="true" /></div>
              <h2 id="upload-title" className="mt-4 text-lg font-bold">Drop your document here</h2>
              <p className="mt-1 text-sm text-base-content/55">PDF or image up to 15 MB</p>
              <button type="button" onClick={() => inputRef.current?.click()} className="btn btn-outline btn-sm mt-5">Browse files</button>
            </div>
          )}
        </div>

        {error && <div role="alert" className="alert alert-error mt-5 text-sm"><span>{error}</span></div>}
        {status === 'success' && <div role="status" className="alert alert-success mt-5"><span>Deck saved. Taking you back to the dashboard…</span></div>}

        <button type="button" onClick={handleGenerate} disabled={!file || status === 'generating' || status === 'success'} className="btn btn-primary mt-5 w-full gap-2">
          {status === 'generating' ? <span className="loading loading-spinner loading-sm" aria-hidden="true" /> : <Sparkles size={18} aria-hidden="true" />}
          {status === 'generating' ? 'Building your deck…' : 'Generate study deck'}
        </button>
      </section>
    </main>
  )
}
