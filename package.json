{
  "name": "kogni",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc -b",
    "build": "next build",
    "lint": "oxlint src app",
    "test": "vitest run --exclude functions/**",
    "test:functions": "npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only database --config firebase.test.json --project demo-kognit-rules \"vitest run test/lib/database.rules.test.ts\"",
    "emulators": "firebase emulators:start --only database,functions",
    "deploy:functions": "firebase deploy --only functions",
    "preview": "next start"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.11.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.70.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.0",
    "daisyui": "^4.12.24",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.2"
  }
}
